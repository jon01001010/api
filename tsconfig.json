{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    // whisper.rn's package exports list no "." entry; point TypeScript at
    // its published types (Metro resolves the package's main field).
    "paths": {
      "whisper.rn": ["./node_modules/whisper.rn/lib/typescript/index.d.ts"]
    },
  },
  "exclude": ["node_modules", "extras", "web/dist", "windows-bundle", "coverage", "src-tauri"]
}
