{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the PocketAgent window may ask the native side to do. Every door is listed; anything outside the app's own folder asks the user first (see SECURITY.md).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-fs-exists",
    "allow-fs-read",
    "allow-fs-write",
    "allow-fs-mkdir",
    "allow-fs-list",
    "allow-fs-stat",
    "allow-fs-remove",
    "allow-fs-copy",
    "allow-fs-move",
    "allow-doc-to-text",
    "allow-fs-download",
    "allow-fs-download-cancel",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-http-request",
    "allow-http-abort",
    "allow-open-external",
    "allow-pc-info",
    "allow-run-command",
    "allow-open-workspace-file",
    "allow-clipboard-read",
    "allow-notify",
    "allow-media-key",
    "allow-print-file",
    "allow-take-screenshot",
    "allow-quick-key-set",
    "allow-pick-model-file",
    "allow-model-server-start",
    "allow-model-server-stop",
    "allow-system-info",
    "allow-startup-timing",
    "allow-pick-import-file",
    "allow-save-copy",
    "allow-preview-put",
    "allow-link-pair",
    "allow-link-on",
    "allow-link-off",
    "allow-link-status",
    "allow-link-forget",
    "allow-link-sync-allow",
    "allow-link-sync-reply",
    "allow-link-answers-allow",
    "allow-homelink-pair",
    "allow-homelink-status",
    "allow-homelink-start-model",
    "allow-homelink-open-tunnel",
    "allow-homelink-sync",
    "allow-homelink-questions",
    "allow-homelink-answer-question",
    "allow-homelink-close-tunnel"
  ]
}
