{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the PocketAgent window may ask the native side to do. Every door is listed; anything outside the app's own folder asks the user first (see SECURITY.md).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-fs-exists",
    "allow-fs-read",
    "allow-fs-write",
    "allow-fs-mkdir",
    "allow-fs-list",
    "allow-fs-stat",
    "allow-fs-remove",
    "allow-fs-copy",
    "allow-fs-move",
    "allow-fs-download",
    "allow-fs-download-cancel",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-http-request",
    "allow-http-abort",
    "allow-pick-model-file",
    "allow-model-server-start",
    "allow-model-server-stop",
    "allow-system-info",
    "allow-startup-timing",
    "allow-preview-put"
  ]
}
